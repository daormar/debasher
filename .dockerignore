*/Makefile
*/Makefile.in
*/*/Makefile
*/*/Makefile.in
bin/
debug/
dev_utils/
debasher-*.tar.gz
claude_sessions.txt

# Frontend: built separately in its own stage, from clean sources.
frontend/node_modules/
frontend/dist/
frontend/.build-stamp

