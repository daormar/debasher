#!/usr/bin/env bats
#
# Unit tests for engine/debasher_lib_processes.sh's process-implementation
# recovery helpers, run against the artifact generated by engine/
# Makefile.am's suffix rule (not the .sh source), so they exercise what
# actually ships. These pin down the exact false-positive/false-negative
# shapes found while debugging the frontend's "import program" feature
# (see debasher::_collect_func_deps's own comments): a same-script helper
# a process's exec function really calls must be pulled in, while a mere
# identifier collision -- a local variable, or a word inside a string or
# an embedded other-language script -- must not.

setup() {
    : "${ENGINE_BUILDDIR:?ENGINE_BUILDDIR must point at the built engine/ dir}"
    source "${ENGINE_BUILDDIR}/debasher_lib_processes"
}

# --- debasher::_blank_string_literals --------------------------------

@test "debasher::_blank_string_literals blanks a single-quoted span" {
    result=$(printf 'before %s after\n' "'count'" | debasher::_blank_string_literals)
    [ "${result}" = "before  after" ]
}

@test "debasher::_blank_string_literals blanks a single-quoted span spanning multiple lines" {
    result=$(printf 'before %s\nmiddle\n%s after\n' "'" "'" | debasher::_blank_string_literals)
    [ "${result}" = "before  after" ]
}

@test "debasher::_blank_string_literals blanks a double-quoted span with no dollar sign" {
    result=$(printf 'echo "no count here"\n' | debasher::_blank_string_literals)
    [ "${result}" = 'echo ' ]
}

@test "debasher::_blank_string_literals keeps a double-quoted span containing a dollar sign" {
    line='echo "value is $count here"'
    result=$(printf '%s\n' "${line}" | debasher::_blank_string_literals)
    [ "${result}" = "${line}" ]
}

# --- debasher::_declared_func_vars ------------------------------------

@test "debasher::_declared_func_vars lists local variable names, not their assigned values" {
    eval 'sample() { local numblocks=$(some_func "$1"); local i start_line count blockfile; count=$(( 1 + 2 )); }'

    run debasher::_declared_func_vars sample
    [ "${status}" -eq 0 ]
    [[ "${lines[*]}" == *"numblocks"* ]]
    [[ "${lines[*]}" == *"i"* ]]
    [[ "${lines[*]}" == *"count"* ]]
    [[ "${lines[*]}" == *"blockfile"* ]]
    # The call on the right-hand side of a declaration is a real
    # dependency, not a declared name -- it must not show up here.
    [[ "${lines[*]}" != *"some_func"* ]]
}

# --- debasher::_collect_func_deps -------------------------------------

# Sources $1 (a here-doc'd script written to a real file, since
# debasher::_collect_func_deps needs "declare -F" -- via extdebug -- to
# report a defining file on disk) and prints the space-joined set of
# dependencies debasher::_collect_func_deps collects for funcname $2,
# funcname itself excluded. Each fixture below has at most one real
# dependency, so this doesn't bother sorting the result.
collect_deps() {
    local scriptfile=$1
    local funcname=$2

    shopt -s extdebug
    source "${scriptfile}"
    local -A seen=()
    debasher::_collect_func_deps "${funcname}" "${scriptfile}" seen
    shopt -u extdebug

    local dep
    local -a deps=()
    for dep in "${!seen[@]}"; do
        [ "${dep}" = "${funcname}" ] && continue
        deps+=("${dep}")
    done
    echo "${deps[*]}"
}

@test "debasher::_collect_func_deps pulls in a helper the exec function actually calls" {
    local scriptfile="${BATS_TEST_TMPDIR}/script.sh"
    cat > "${scriptfile}" <<'EOF'
helper()
{
    :
}

main_proc()
{
    helper
}
EOF

    result=$(collect_deps "${scriptfile}" "main_proc")
    [ "${result}" = "helper" ]
}

@test "debasher::_collect_func_deps ignores a local variable that collides with a sibling process name" {
    local scriptfile="${BATS_TEST_TMPDIR}/script.sh"
    cat > "${scriptfile}" <<'EOF'
count()
{
    :
}

fragment()
{
    local i count
    count=$(( 1 + 1 ))
    echo "${count}"
}
EOF

    result=$(collect_deps "${scriptfile}" "fragment")
    [ -z "${result}" ]
}

@test "debasher::_collect_func_deps ignores a sibling process name that only appears in an embedded string/script" {
    local scriptfile="${BATS_TEST_TMPDIR}/script.sh"
    cat > "${scriptfile}" <<'EOF'
count()
{
    :
}

count_chars()
{
    awk '
        {
            count[$1]++
        }
        END {
            for (c in count) print c, count[c]
        }
    '
}

worker_task()
{
    count_chars "$1"
}
EOF

    result=$(collect_deps "${scriptfile}" "worker_task")
    [ "${result}" = "count_chars" ]
}
