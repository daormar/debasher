#!/usr/bin/env bats
#
# Unit tests for engine/debasher_lib_docker.sh, run against the artifacts
# generated by engine/Makefile.am's suffix rule (not the .sh sources).
# docker is replaced by a fake executable that records its calls, so that
# the tests run where docker is not installed.

setup() {
    : "${ENGINE_BUILDDIR:?ENGINE_BUILDDIR must point at the built engine/ dir}"
    debasher_pkglibdir="${ENGINE_BUILDDIR}"
    source "${ENGINE_BUILDDIR}/debasher_lib.sh"

    export DOCKER_CALLS="${BATS_TEST_TMPDIR}/docker_calls"
    export FAKE_IMGS="${BATS_TEST_TMPDIR}/imgs"
    mkdir -p "${FAKE_IMGS}"
    : > "${DOCKER_CALLS}"

    # An image is present when FAKE_IMGS holds a file named after it, with
    # every "/" turned into "_"; a pull fails when FAKE_PULL_STATUS is not 0
    DOCKER="${BATS_TEST_TMPDIR}/docker"
    cat > "${DOCKER}" <<'EOF'
#!/usr/bin/env bash
echo "$*" >> "${DOCKER_CALLS}"
case "$1 $2" in
    "image inspect")
        [ -e "${FAKE_IMGS}/${3//\//_}" ]
        ;;
    "pull "*)
        exit "${FAKE_PULL_STATUS:-0}"
        ;;
esac
EOF
    chmod +x "${DOCKER}"
}

@test "pull_docker_img leaves a present image alone" {
    touch "${FAKE_IMGS}/library_hello-world"

    run pull_docker_img library/hello-world

    [ "${status}" -eq 0 ]
    ! grep -q "^pull" "${DOCKER_CALLS}" || false
}

@test "pull_docker_img pulls a missing image" {
    run pull_docker_img library/hello-world

    [ "${status}" -eq 0 ]
    grep -qx "pull library/hello-world" "${DOCKER_CALLS}"
}

@test "pull_docker_img fails when the pull fails" {
    export FAKE_PULL_STATUS=1

    run pull_docker_img library/hello-world

    [ "${status}" -eq 1 ]
}

@test "pull_docker_img fails with its message when configure found no docker" {
    DOCKER="no"

    run pull_docker_img library/hello-world

    [ "${status}" -eq 1 ]
    [[ "${output}" == *"docker was not found"* ]]
}

@test "_pull_docker_imgs calls the _docker_imgs method of each process that has one, once" {
    declare -gA DEBASHER_PROGRAM_PROCESSES=([withimg]=1 [noimg]=1)
    withimg_docker_imgs() { echo withimg >> "${BATS_TEST_TMPDIR}/methods"; }

    run debasher::_pull_docker_imgs

    [ "${status}" -eq 0 ]
    [ "$(cat "${BATS_TEST_TMPDIR}/methods")" = "withimg" ]
}

@test "_pull_docker_imgs fails when a _docker_imgs method fails" {
    declare -gA DEBASHER_PROGRAM_PROCESSES=([withimg]=1)
    withimg_docker_imgs() { return 1; }

    run debasher::_pull_docker_imgs

    [ "${status}" -eq 1 ]
}
