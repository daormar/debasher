#!/usr/bin/env bats
#
# Unit tests for engine/debasher_lib_args.sh, run against the artifact
# generated by engine/Makefile.am's suffix rule (not the .sh source), so
# they exercise what actually ships. They cover the reading of option
# values from function arguments and the serialization of a command line.

setup() {
    : "${ENGINE_BUILDDIR:?ENGINE_BUILDDIR must point at the built engine/ dir}"
    debasher_pkglibdir="${ENGINE_BUILDDIR}"
    source "${ENGINE_BUILDDIR}/debasher_lib.sh"
}

# --- debasher::read_opt_value_from_func_args -----------------------------

@test "debasher::read_opt_value_from_func_args reads a negative number and an empty value" {
    [ "$(debasher::read_opt_value_from_func_args -n -n -5 -e '' -f)" = "-5" ]
    [ "$(debasher::read_opt_value_from_func_args -e -n -5 -e '' -f)" = "" ]
    [ "$(debasher::read_opt_value_from_func_args -f -n -5 -e '' -f)" = "${DEBASHER_VOID_VALUE}" ]
}

# --- debasher::_sep_serialized_to_qstr -----------------------------------

@test "debasher::_sep_serialized_to_qstr prints an empty value as an empty quoted word" {
    local sargs="-e${DEBASHER_ARG_SEP}${DEBASHER_ARG_SEP}-f"
    run debasher::_sep_serialized_to_qstr "${DEBASHER_ARG_SEP}" "${sargs}"
    [ "${output}" = "-e '' -f " ]
    run debasher::_sep_serialized_to_qstr "${DEBASHER_ARG_SEP}" ""
    [ "${output}" = "" ]
}
