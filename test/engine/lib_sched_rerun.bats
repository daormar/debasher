#!/usr/bin/env bats
#
# Unit tests for engine/debasher_lib_sched_rerun.sh, the functions that
# decide which processes debasher_exec runs again, run against the
# artifacts generated by engine/Makefile.am's suffix rule (not the .sh
# sources), so they exercise what actually ships.

setup() {
    : "${ENGINE_BUILDDIR:?ENGINE_BUILDDIR must point at the built engine/ dir}"
    debasher_pkglibdir="${ENGINE_BUILDDIR}"
    source "${ENGINE_BUILDDIR}/debasher_lib.sh"

    # debasher_lib.sh declares its arrays for a script's top level; inside
    # setup() a bare declare would be local to it, so force them global.
    declare -gA DEBASHER_RERUN_PROCESSES=()
    declare -gA DEBASHER_PROGRAM_PROCESSES=()
    declare -gA DEBASHER_FINAL_PROCESS_SPEC=()
    declare -ga DEBASHER_PROGRAM_MODULES=()
    declare -g DEBASHER_PROGRAM_TYPE="${DEBASHER_PROGRAM_TYPE_GENERAL}"
}

# --- rerun due to a code update --------------------------------------------

@test "debasher::_define_rerun_processes_due_to_code_update marks a finished process whose script is older than a module" {
    local outd="${BATS_TEST_TMPDIR}/out"
    local module="${BATS_TEST_TMPDIR}/mod.sh"
    DEBASHER_PROGRAM_PROCESSES["oldproc"]=1
    DEBASHER_PROGRAM_PROCESSES["newproc"]=1
    DEBASHER_PROGRAM_MODULES=("${module}")
    mkdir -p "${outd}/__exec__/oldproc" "${outd}/__exec__/newproc"
    touch -d "2020-01-01" "${outd}/__exec__/oldproc/oldproc"
    touch -d "2020-01-03" "${outd}/__exec__/newproc/newproc"
    touch -d "2020-01-02" "${module}"
    debasher::_get_process_status() {
        echo "${DEBASHER_FINISHED_PROCESS_STATUS}"
    }

    debasher::_define_rerun_processes_due_to_code_update "${outd}" 2> "${BATS_TEST_TMPDIR}/stderr"

    [ "${DEBASHER_RERUN_PROCESSES["oldproc"]}" = "${DEBASHER_OUTDATED_CODE_RERUN_REASON}" ]
    [ -z "${DEBASHER_RERUN_PROCESSES["newproc"]+x}" ]
    ! grep -q "command not found" "${BATS_TEST_TMPDIR}/stderr" || false
}

# --- forced rerun ---------------------------------------------------------

@test "debasher::_define_forced_rerun_processes marks only the processes with force=yes" {
    local sep="${DEBASHER_BEGIN_OF_ADDITIONAL_PROCSPECS_SEP}"
    DEBASHER_FINAL_PROCESS_SPEC["forced"]="forced cpus=1 mem=32 time=00:01:00 ${sep} force=yes"
    DEBASHER_FINAL_PROCESS_SPEC["plain"]="plain cpus=1 mem=32 time=00:01:00"

    debasher::_define_forced_rerun_processes

    [ "${DEBASHER_RERUN_PROCESSES["forced"]}" = "${DEBASHER_FORCED_RERUN_REASON}" ]
    [ -z "${DEBASHER_RERUN_PROCESSES["plain"]+x}" ]
}

@test "debasher::_define_forced_rerun_processes prints no error for an empty force attribute" {
    local sep="${DEBASHER_BEGIN_OF_ADDITIONAL_PROCSPECS_SEP}"
    DEBASHER_FINAL_PROCESS_SPEC["emptyforce"]="emptyforce cpus=1 mem=32 time=00:01:00 ${sep} force="

    run debasher::_define_forced_rerun_processes
    [ "${status}" -eq 0 ]
    [ -z "${output}" ]
}

# --- rerun due to an unfinished producer ------------------------------------

# a failed; x finished. Every other process finished but e, with these
# dependencies on them
setup_unfinished_producer() {
    local sep="${DEBASHER_BEGIN_OF_ADDITIONAL_PROCSPECS_SEP}"
    local -A deps=(
        ["b"]="afterany:a" ["c"]="afterok:x?after:a" ["d"]="afterok:b" ["e"]="afterany:a"
        ["f"]="none" ["g"]="afternotok:a" ["h"]="aftercorr:a" ["i"]="none:a" ["j"]="afterok:x"
    )
    declare -gA DEBASHER_PROCESS_DEPENDENCIES_SIMPLIFIED=()
    local proc
    for proc in "${!deps[@]}"; do
        DEBASHER_FINAL_PROCESS_SPEC[${proc}]="${proc} cpus=1 mem=32 time=00:01:00 ${sep} processdeps=${deps[${proc}]}"
        DEBASHER_PROCESS_DEPENDENCIES_SIMPLIFIED[${proc}]=$(debasher::_get_processdeps_from_detailed_spec "${deps[${proc}]}")
    done
    for proc in a b c d e f g h i j x; do
        DEBASHER_PROGRAM_PROCESSES[${proc}]=1
    done
    debasher::_get_process_status() {
        case $2 in
            a|e) echo "${DEBASHER_UNFINISHED_PROCESS_STATUS}" ;;
            *) echo "${DEBASHER_FINISHED_PROCESS_STATUS}" ;;
        esac
    }
}

@test "debasher::_define_rerun_processes_due_to_unfinished_producers marks a finished process that after, afterany or afterok in a ? list let finish before its producer" {
    setup_unfinished_producer

    debasher::_define_rerun_processes_due_to_unfinished_producers "${BATS_TEST_TMPDIR}"

    [ "${DEBASHER_RERUN_PROCESSES["b"]}" = "${DEBASHER_UNFINISHED_PRODUCER_RERUN_REASON}" ]
    [ "${DEBASHER_RERUN_PROCESSES["c"]}" = "${DEBASHER_UNFINISHED_PRODUCER_RERUN_REASON}" ]
    # d and j depend on finished processes; e has not finished, and runs
    # anyway; f depends on nothing
    local proc
    for proc in a d e f j; do
        [ -z "${DEBASHER_RERUN_PROCESSES[${proc}]+x}" ]
    done
}

@test "debasher::_define_rerun_processes_due_to_unfinished_producers leaves out afternotok, aftercorr and none" {
    setup_unfinished_producer

    debasher::_define_rerun_processes_due_to_unfinished_producers "${BATS_TEST_TMPDIR}"

    local proc
    for proc in g h i; do
        [ -z "${DEBASHER_RERUN_PROCESSES[${proc}]+x}" ]
    done
}

@test "the mark of a process that depends on an unfinished one spreads to the processes that depend on it" {
    setup_unfinished_producer

    debasher::_define_rerun_processes_due_to_unfinished_producers "${BATS_TEST_TMPDIR}"
    debasher::_propagate_rerun_mark_due_to_deps_iter

    [ "${DEBASHER_RERUN_PROCESSES["d"]}" = "${DEBASHER_PROPAGATE_DEPS_RERUN_REASON}" ]
}

# --- resuming a resident program -------------------------------------------

# $1: status that debasher::_get_process_status reports for every process,
# by name, as "<process>=<status> ..."
fake_statuses() {
    FAKE_STATUSES="$1"
    debasher::_get_process_status() {
        local entry
        for entry in ${FAKE_STATUSES}; do
            if [ "${entry%%=*}" = "$2" ]; then
                echo "${entry#*=}"
                return 0
            fi
        done
    }
}

@test "debasher::_define_rerun_processes_due_to_resident_resume marks every stopped process of a resident program" {
    declare -gA DEBASHER_RERUN_PROCESSES=()
    DEBASHER_PROGRAM_TYPE="${DEBASHER_PROGRAM_TYPE_RESIDENT}"
    DEBASHER_PROGRAM_PROCESSES=([halted]=1 [partial]=1 [running]=1 [crashed]=1 [new]=1)
    fake_statuses "halted=${DEBASHER_FINISHED_PROCESS_STATUS} partial=${DEBASHER_UNFINISHED_BUT_RUNNABLE_PROCESS_STATUS} running=${DEBASHER_INPROGRESS_PROCESS_STATUS} crashed=${DEBASHER_UNFINISHED_PROCESS_STATUS} new=${DEBASHER_TODO_PROCESS_STATUS}"

    debasher::_define_rerun_processes_due_to_resident_resume "/unused"

    [ "${DEBASHER_RERUN_PROCESSES[halted]}" = "${DEBASHER_RESIDENT_RESUME_RERUN_REASON}" ]
    [ "${DEBASHER_RERUN_PROCESSES[partial]}" = "${DEBASHER_RESIDENT_RESUME_RERUN_REASON}" ]
    # Also an array with only some tasks finished, which the engine reports
    # as unfinished
    [ "${DEBASHER_RERUN_PROCESSES[crashed]}" = "${DEBASHER_RESIDENT_RESUME_RERUN_REASON}" ]
    # Not to be touched (running) or launched anyway (new)
    [ -z "${DEBASHER_RERUN_PROCESSES[running]:-}" ]
    [ -z "${DEBASHER_RERUN_PROCESSES[new]:-}" ]
}

@test "debasher::_define_rerun_processes_due_to_resident_resume is a no-op for a general program" {
    declare -gA DEBASHER_RERUN_PROCESSES=()
    DEBASHER_PROGRAM_PROCESSES=([done]=1)
    fake_statuses "done=${DEBASHER_FINISHED_PROCESS_STATUS}"

    debasher::_define_rerun_processes_due_to_resident_resume "/unused"

    [ "${#DEBASHER_RERUN_PROCESSES[@]}" -eq 0 ]
}
