#!/usr/bin/env bats
#
# Unit tests for engine/debasher_lib_conda.sh, run against the artifacts
# generated by engine/Makefile.am's suffix rule (not the .sh sources).
# conda is replaced by a fake executable that records its calls, so that
# the tests run where conda is not installed.

bats_require_minimum_version 1.5.0

setup() {
    : "${ENGINE_BUILDDIR:?ENGINE_BUILDDIR must point at the built engine/ dir}"
    debasher_pkglibdir="${ENGINE_BUILDDIR}"
    source "${ENGINE_BUILDDIR}/debasher_lib.sh"

    # Whatever conda the shell of the test has is left out
    unset -f conda
    unset CONDA_EXE CONDA_CMD DEBASHER_YML_DIR

    export CONDA_CALLS="${BATS_TEST_TMPDIR}/conda_calls"
    export FAKE_ENVS="${BATS_TEST_TMPDIR}/envs"
    mkdir -p "${FAKE_ENVS}" "${BATS_TEST_TMPDIR}/bin"
    : > "${CONDA_CALLS}"

    # The environment files that DeBasher installs
    debasher_datadir="${BATS_TEST_TMPDIR}/datadir"
    mkdir -p "${debasher_datadir}/conda_envs"

    # The engine, loaded by this function, declares the variable in it: a
    # plain assignment would only set the variable of this function
    mkdir -p "${BATS_TEST_TMPDIR}/condadir"
    declare -g DEBASHER_CONDA_DIR="${BATS_TEST_TMPDIR}/condadir"
}

# Writes at $1 a fake conda executable. Its hook (conda shell.bash hook)
# exports CONDA_EXE, records in FAKE_HOOK_FROM the executable it came
# from, and defines a conda function that calls the executable, as the
# hook of conda does. An environment exists when FAKE_ENVS holds a file
# named after it, with every "/" turned into "_"; env create creates one,
# unless FAKE_CREATE_STATUS is not 0.
make_fake_conda() {
    local path=$1
    cat > "${path}" <<'EOF'
#!/usr/bin/env bash
echo "$*" >> "${CONDA_CALLS}"
case "$1" in
    shell.bash)
        printf 'export CONDA_EXE=%q\n' "$0"
        printf 'FAKE_HOOK_FROM=%q\n' "$0"
        echo 'conda() { "${CONDA_EXE}" "$@"; }'
        ;;
    activate)
        [ -e "${FAKE_ENVS}/${2//\//_}" ]
        ;;
    deactivate)
        :
        ;;
    env)
        # env create -f <yml> -n|-p <name>
        echo "creating $6 from $4"
        [ "${FAKE_CREATE_STATUS:-0}" -eq 0 ] || exit 1
        touch "${FAKE_ENVS}/${6//\//_}"
        ;;
esac
EOF
    chmod +x "${path}"
}

@test "_load_conda_functions loads the hook from CONDA_EXE before CONDA_CMD" {
    make_fake_conda "${BATS_TEST_TMPDIR}/bin/conda_exe"
    make_fake_conda "${BATS_TEST_TMPDIR}/bin/conda_cmd"
    export CONDA_EXE="${BATS_TEST_TMPDIR}/bin/conda_exe"
    CONDA_CMD="${BATS_TEST_TMPDIR}/bin/conda_cmd"

    debasher::_load_conda_functions

    [ "${FAKE_HOOK_FROM}" = "${BATS_TEST_TMPDIR}/bin/conda_exe" ]
    declare -F conda > /dev/null
}

@test "_load_conda_functions loads the hook from CONDA_CMD when there is no CONDA_EXE" {
    make_fake_conda "${BATS_TEST_TMPDIR}/bin/conda_cmd"
    CONDA_CMD="${BATS_TEST_TMPDIR}/bin/conda_cmd"

    debasher::_load_conda_functions

    [ "${FAKE_HOOK_FROM}" = "${BATS_TEST_TMPDIR}/bin/conda_cmd" ]
    [ "${CONDA_EXE}" = "${BATS_TEST_TMPDIR}/bin/conda_cmd" ]
}

@test "_load_conda_functions leaves alone a shell that has the conda functions and CONDA_EXE" {
    make_fake_conda "${BATS_TEST_TMPDIR}/bin/conda"
    export CONDA_EXE="${BATS_TEST_TMPDIR}/bin/conda"
    conda() { "${CONDA_EXE}" "$@"; }

    debasher::_load_conda_functions

    ! grep -q "shell.bash hook" "${CONDA_CALLS}" || false
}

@test "conda_activate works in a shell that has the conda functions but not CONDA_EXE" {
    # As a task whose context carries the functions of conda, on a node
    # whose environment has no CONDA_EXE
    make_fake_conda "${BATS_TEST_TMPDIR}/bin/conda"
    CONDA_CMD="${BATS_TEST_TMPDIR}/bin/conda"
    conda() { "${CONDA_EXE}" "$@"; }
    touch "${FAKE_ENVS}/myenv"

    conda_activate myenv

    [ "${CONDA_EXE}" = "${BATS_TEST_TMPDIR}/bin/conda" ]
    grep -qx "activate myenv" "${CONDA_CALLS}"
}

@test "conda_activate fails with its message when there is no conda executable" {
    run conda_activate myenv

    [ "${status}" -eq 1 ]
    [[ "${output}" == *"conda was not found"* ]]
}

@test "define_conda_env leaves an existing environment alone" {
    make_fake_conda "${BATS_TEST_TMPDIR}/bin/conda"
    CONDA_CMD="${BATS_TEST_TMPDIR}/bin/conda"
    touch "${FAKE_ENVS}/myenv"

    run define_conda_env myenv myenv.yml

    [ "${status}" -eq 0 ]
    ! grep -q "^env create" "${CONDA_CALLS}" || false
}

@test "define_conda_env creates a missing environment, with its log in DEBASHER_CONDA_DIR" {
    make_fake_conda "${BATS_TEST_TMPDIR}/bin/conda"
    CONDA_CMD="${BATS_TEST_TMPDIR}/bin/conda"
    touch "${debasher_datadir}/conda_envs/myenv.yml"

    run --separate-stderr define_conda_env myenv myenv.yml

    [ "${status}" -eq 0 ]
    # Every message of the preparation goes to the standard error
    [ -z "${output}" ]
    grep -qx "env create -f ${debasher_datadir}/conda_envs/myenv.yml -n myenv" "${CONDA_CALLS}"
    grep -q "creating myenv" "${DEBASHER_CONDA_DIR}/myenv.log"
}

@test "define_conda_env writes the log into the .conda directory of the output directory without DEBASHER_CONDA_DIR" {
    make_fake_conda "${BATS_TEST_TMPDIR}/bin/conda"
    CONDA_CMD="${BATS_TEST_TMPDIR}/bin/conda"
    touch "${debasher_datadir}/conda_envs/myenv.yml"
    unset DEBASHER_CONDA_DIR
    DEBASHER_PROGRAM_OUTDIR="${BATS_TEST_TMPDIR}/out"
    mkdir -p "${DEBASHER_PROGRAM_OUTDIR}/.conda"

    run define_conda_env myenv myenv.yml

    [ "${status}" -eq 0 ]
    [ -f "${DEBASHER_PROGRAM_OUTDIR}/.conda/myenv.log" ]
}

@test "define_conda_env creates an environment given by its absolute path, with its log in the conda directory" {
    make_fake_conda "${BATS_TEST_TMPDIR}/bin/conda"
    CONDA_CMD="${BATS_TEST_TMPDIR}/bin/conda"
    touch "${debasher_datadir}/conda_envs/myenv.yml"
    local env_path="${BATS_TEST_TMPDIR}/prefixes/myenv"

    run define_conda_env "${env_path}" myenv.yml

    [ "${status}" -eq 0 ]
    grep -qx "env create -f ${debasher_datadir}/conda_envs/myenv.yml -p ${env_path}" "${CONDA_CALLS}"
    [ -f "${DEBASHER_CONDA_DIR}/${env_path//\//_}.log" ]
}

@test "define_conda_env fails, naming the log, when the environment cannot be created" {
    make_fake_conda "${BATS_TEST_TMPDIR}/bin/conda"
    CONDA_CMD="${BATS_TEST_TMPDIR}/bin/conda"
    touch "${debasher_datadir}/conda_envs/myenv.yml"
    export FAKE_CREATE_STATUS=1

    run define_conda_env myenv myenv.yml

    [ "${status}" -eq 1 ]
    [[ "${output}" == *"See ${DEBASHER_CONDA_DIR}/myenv.log"* ]]
}

@test "define_conda_env fails with one error when there is no conda executable" {
    run define_conda_env myenv myenv.yml

    [ "${status}" -eq 1 ]
    [ "$(grep -c "conda was not found" <<< "${output}")" -eq 1 ]
}

@test "_get_abs_yml_fname looks in the directories of DEBASHER_YML_DIR in order, then among the installed files" {
    local first="${BATS_TEST_TMPDIR}/yml1" second="${BATS_TEST_TMPDIR}/yml2"
    mkdir -p "${first}" "${second}"
    touch "${second}/both.yml" "${first}/both.yml" "${second}/second.yml"
    DEBASHER_YML_DIR="${first}${DEBASHER_YML_DIR_SEP}${second}"

    [ "$(debasher::_get_abs_yml_fname both.yml)" = "${first}/both.yml" ]
    [ "$(debasher::_get_abs_yml_fname second.yml)" = "${second}/second.yml" ]
    [ "$(debasher::_get_abs_yml_fname other.yml)" = "${debasher_datadir}/conda_envs/other.yml" ]
}

@test "_prepare_conda_envs calls the _conda_envs method of each process that has one, once" {
    declare -gA DEBASHER_PROGRAM_PROCESSES=([withenv]=1 [noenv]=1)
    withenv_conda_envs() { echo withenv >> "${BATS_TEST_TMPDIR}/methods"; }

    run debasher::_prepare_conda_envs

    [ "${status}" -eq 0 ]
    [ "$(cat "${BATS_TEST_TMPDIR}/methods")" = "withenv" ]
}

@test "_prepare_conda_envs fails when a _conda_envs method fails" {
    declare -gA DEBASHER_PROGRAM_PROCESSES=([withenv]=1)
    withenv_conda_envs() { return 1; }

    run debasher::_prepare_conda_envs

    [ "${status}" -eq 1 ]
}
