#!/usr/bin/env bats
#
# Unit tests for engine/debasher_lib_process_spec.sh, run against the
# artifact generated by engine/Makefile.am's suffix rule (not the .sh
# source), so they exercise what actually ships. They cover the check of
# the process dependencies given explicitly in a process specification,
# and the checks of the final process specification.

setup() {
    : "${ENGINE_BUILDDIR:?ENGINE_BUILDDIR must point at the built engine/ dir}"
    debasher_pkglibdir="${ENGINE_BUILDDIR}"
    source "${ENGINE_BUILDDIR}/debasher_lib.sh"
}

# --- debasher::_check_explicit_processdeps -------------------------------

@test "debasher::_check_explicit_processdeps accepts none and lists with one separator" {
    debasher::_check_explicit_processdeps "p" "none"
    debasher::_check_explicit_processdeps "p" "afterok:a"
    debasher::_check_explicit_processdeps "p" "afterok:a,after:ns.b"
    debasher::_check_explicit_processdeps "p" "afterok:a?afternotok:b"
}

@test "debasher::_check_explicit_processdeps refuses an unknown type" {
    run debasher::_check_explicit_processdeps "p" "afterok:a,afterbogus:b"
    [ "${status}" -eq 1 ]
    [[ "${output}" == *"unknown type: afterbogus"* ]]
}

@test "debasher::_check_explicit_processdeps refuses a dependency without a type or a process" {
    run debasher::_check_explicit_processdeps "p" "a"
    [ "${status}" -eq 1 ]
    run debasher::_check_explicit_processdeps "p" "afterok:"
    [ "${status}" -eq 1 ]
    run debasher::_check_explicit_processdeps "p" ":a"
    [ "${status}" -eq 1 ]
}

@test "debasher::_check_explicit_processdeps refuses both separators in one list" {
    run debasher::_check_explicit_processdeps "p" "afterok:a,afterok:b?afterok:c"
    [ "${status}" -eq 1 ]
    [[ "${output}" == *"use one of them"* ]]
}

@test "debasher::_check_explicit_processdeps refuses an empty element, also the last one" {
    local procdeps
    for procdeps in "afterok:a," ",afterok:a" "afterok:a,,after:b" "afterok:a?"; do
        run debasher::_check_explicit_processdeps "p" "${procdeps}"
        [ "${status}" -eq 1 ]
        [[ "${output}" == *"Error: the dependencies of process p (${procdeps}) have an empty element"* ]]
    done
}

@test "debasher::_check_explicit_processdeps refuses, with a comma, two dependencies on one process that no run satisfies, and keeps the others" {
    run debasher::_check_explicit_processdeps "p" "afterok:a,afternotok:a"
    [ "${status}" -eq 1 ]
    [[ "${output}" == *"Error: the dependencies of process p on a (afterok and afternotok, which all have to hold) cannot both be satisfied by any run of a"* ]]
    run debasher::_check_explicit_processdeps "p" "aftercorr:a,after:b,afternotok:a"
    [ "${status}" -eq 1 ]

    debasher::_check_explicit_processdeps "p" "afterok:a,afterok:a"
    debasher::_check_explicit_processdeps "p" "afterany:a,afternotok:a"
    debasher::_check_explicit_processdeps "p" "afterok:a,afternotok:b"
    # With a question mark one of them is enough
    debasher::_check_explicit_processdeps "p" "afterok:a?afternotok:a"
}

# --- debasher::_gen_final_procspec ---------------------------------------

# Registers the processes given as "name|computational specs|additional
# specs", as add_debasher_process does
register_processes() {
    declare -gA DEBASHER_PROGRAM_PROCESSES DEBASHER_INITIAL_PROCESS_SPEC \
        DEBASHER_FINAL_PROCESS_SPEC DEBASHER_PROCESS_DEPENDENCIES_SIMPLIFIED
    local entry name comp additional
    for entry in "$@"; do
        IFS='|' read -r name comp additional <<< "${entry}"
        DEBASHER_PROGRAM_PROCESSES["${name}"]="${DEBASHER_REGULAR_PROCESS_TYPE}"
        DEBASHER_INITIAL_PROCESS_SPEC["${name}"]=$(debasher::_print_process_entry "${name}" "${comp}" "${additional}")
    done
}

@test "debasher::_gen_final_procspec refuses a process without cpus, mem or time" {
    local missing comp
    for missing in cpus mem time; do
        case "${missing}" in
            cpus) comp="mem=32;time=00:01:00" ;;
            mem) comp="cpus=1;time=00:01:00" ;;
            time) comp="cpus=1;mem=32" ;;
        esac
        register_processes "p|${comp}|processdeps=none"

        run debasher::_gen_final_procspec ""
        [ "${status}" -eq 1 ]
        [[ "${output}" == *"${missing} computational specification not given for process p"* ]]
    done
}

@test "debasher::_gen_final_procspec refuses an explicit dependency on a process not in the program" {
    register_processes "a|cpus=1;mem=32;time=00:01:00|processdeps=none" \
                       "b|cpus=1;mem=32;time=00:01:00|processdeps=afterok:nosuch"

    run debasher::_gen_final_procspec ""
    [ "${status}" -eq 1 ]
    [[ "${output}" == *"process nosuch is given as a dependency for b, but it does not exist"* ]]
}

@test "debasher::_gen_final_procspec keeps explicit dependencies on processes of the program" {
    register_processes "a|cpus=1;mem=32;time=00:01:00|processdeps=none" \
                       "b|cpus=1;mem=32;time=00:01:00|processdeps=afterok:a"

    debasher::_gen_final_procspec ""
    [ "${DEBASHER_PROCESS_DEPENDENCIES_SIMPLIFIED[b]}" = "a" ]
    [ "${DEBASHER_FINAL_PROCESS_SPEC[b]}" = "${DEBASHER_INITIAL_PROCESS_SPEC[b]}" ]
}

@test "debasher::_gen_final_procspec gives a single error for a process without cpus" {
    register_processes "p|mem=32;time=00:01:00|processdeps=none"

    run debasher::_gen_final_procspec ""
    [ "${status}" -eq 1 ]
    [ "${#lines[@]}" -eq 1 ]
}

# --- the attributes of a specification ------------------------------------

@test "an attribute is read as written, with no glob expanded and its blanks kept" {
    cd "${BATS_TEST_TMPDIR}"
    touch afile

    [ "$(debasher::extract_attr_from_process_additional_specs "alias_opt_map=*;x=a  b" "alias_opt_map")" = "*" ]
    [ "$(debasher::extract_attr_from_process_additional_specs "alias_opt_map=*;x=a  b" "x")" = "a  b" ]
    [ "$(debasher::extract_attr_from_process_additional_specs "x=1" "y")" = "${DEBASHER_ATTR_NOT_FOUND}" ]
    [ "$(debasher::_extract_processname_from_process_spec "ns.proc cpus=1 ||| ")" = "ns.proc" ]
}

@test "debasher::_program_process_spec_is_ok refuses an attribute it does not know, and one written in the other part" {
    local sep="${DEBASHER_BEGIN_OF_ADDITIONAL_PROCSPECS_SEP}"

    debasher::_program_process_spec_is_ok "p cpus=1 mem=32 time=00:01:00 throttle=2 ${sep} processdeps=afterok:a;force=yes"
    debasher::_program_process_spec_is_ok "p cpus=1;mem=32;time=00:01:00;max_concurrent_runs=2 ${sep} "

    run debasher::_program_process_spec_is_ok "p cpus=1 mem=32 time=00:01:00 thottle=2 ${sep} "
    [ "${status}" -eq 1 ]
    [[ "${output}" == *"process p has an unknown computational specification: thottle=2"* ]]

    run debasher::_program_process_spec_is_ok "p cpus=1 mem=32 time=00:01:00 processdeps=afterany:q ${sep} "
    [ "${status}" -eq 1 ]
    [[ "${output}" == *"processdeps is written among the computational specifications of process p"* ]]

    run debasher::_program_process_spec_is_ok "p cpus=1 mem=32 time=00:01:00 ${sep} throttle=2"
    [ "${status}" -eq 1 ]
    [[ "${output}" == *"throttle is written among the additional specifications of process p"* ]]

    run debasher::_program_process_spec_is_ok "p cpus=1 mem=32 time=00:01:00 ${sep} forse=yes"
    [ "${status}" -eq 1 ]
    [[ "${output}" == *"process p has an unknown additional specification: forse=yes"* ]]
}
