#!/usr/bin/env bats
#
# Unit tests for engine/debasher_lib_mirror.sh, the mirror taps of the fifos
# declared with --mirror, run against the artifact generated by
# engine/Makefile.am's suffix rule (not the .sh source), so they exercise
# what actually ships.
#
# The taps are run with real fifos and real background processes. A test
# plays the task that owns the fifo: it starts the tap, holds a write end of
# the shim fifo while it writes, as the task does while its process function
# runs, and closes it at the end.

# A test that hangs fails instead of hanging the whole suite: a tap that
# never ends is exactly what some of these tests guard against.
BATS_TEST_TIMEOUT=30

setup() {
    : "${ENGINE_BUILDDIR:?ENGINE_BUILDDIR must point at the built engine/ dir}"
    debasher_pkglibdir="${ENGINE_BUILDDIR}"

    # The tap calls "${SLEEP}" and "${CAT}", and now_ms below "${PYTHON}",
    # which the tool-path preamble of an installed script sets
    SLEEP="$(command -v sleep)"
    CAT="$(command -v cat)"
    RM="$(command -v rm)"
    PYTHON="$(command -v python3)"

    source "${ENGINE_BUILDDIR}/debasher_lib.sh"

    shimfifo="${BATS_TEST_TMPDIR}/shim"
    realfifo="${BATS_TEST_TMPDIR}/real"
    mirrorfile="${BATS_TEST_TMPDIR}/mirror.log"
    readerout="${BATS_TEST_TMPDIR}/reader_out"
    mkfifo "${shimfifo}" "${realfifo}"
    : > "${mirrorfile}"
}

teardown() {
    if [ -n "${tap_pid:-}" ] && kill -0 "${tap_pid}" 2>/dev/null; then
        kill -9 "${tap_pid}" 2>/dev/null
    fi
    if [ -n "${owner_pid:-}" ] && kill -0 "${owner_pid}" 2>/dev/null; then
        kill -9 "${owner_pid}" 2>/dev/null
    fi
}

now_ms() {
    debasher::_now_ms
}

# Starts a tap whose owner is this test, and opens the write end that the
# task holds, registering both as debasher::_start_fifo_mirror_taps_for_process
# does
start_tap() {
    debasher::_run_fifo_mirror_tap "${shimfifo}" "${realfifo}" "${mirrorfile}" "$$" &
    tap_pid=$!
    DEBASHER_FIFO_MIRROR_TAP_PIDS=("${tap_pid}")
    DEBASHER_FIFO_MIRROR_TAP_SHIMS=("${shimfifo}")
    DEBASHER_FIFO_MIRROR_TAP_FDS=()
    local fd
    exec {fd}>"${shimfifo}"
    DEBASHER_FIFO_MIRROR_TAP_FDS+=("${fd}")
}

# Waits until the mirror log holds $1 lines, which the tap writes before it
# forwards each line to the real fifo.
wait_for_mirror_lines() {
    local i
    for (( i = 0; i < 100; i++ )); do
        [ "$(wc -l < "${mirrorfile}")" -ge "$1" ] && return 0
        "${SLEEP}" 0.05
    done
    return 1
}

# Waits until the process $1 has ended, for at most $2 seconds
wait_until_gone() {
    local i
    for (( i = 0; i < $2 * 20; i++ )); do
        kill -0 "$1" 2>/dev/null || return 0
        "${SLEEP}" 0.05
    done
    ! kill -0 "$1" 2>/dev/null
}

@test "a mirror tap forwards the lines of several opens to a reader that opens the real fifo anew for each line" {
    start_tap

    local got1 got2
    printf 'one\n' > "${shimfifo}"
    got1=$(IFS= read -r line < "${realfifo}" && printf '%s' "${line}")
    printf 'two\n' > "${shimfifo}"
    got2=$(IFS= read -r line < "${realfifo}" && printf '%s' "${line}")

    debasher::_stop_fifo_mirror_taps
    [ "${got1}" = "one" ]
    [ "${got2}" = "two" ]
    [ "$(cat "${mirrorfile}")" = $'one\ntwo' ]
}

@test "a reader that opens the real fifo once gets the lines of every open of the owner, and the end of the data when the task closes its write end" {
    cat "${realfifo}" > "${readerout}" &
    local reader_pid=$!
    start_tap

    printf 'a\nb\n' > "${shimfifo}"
    printf 'c\n' > "${shimfifo}"
    wait_for_mirror_lines 3
    # The owner has closed the shim twice: the reader is still reading
    kill -0 "${reader_pid}"

    debasher::_stop_fifo_mirror_taps
    wait "${reader_pid}"
    [ "$(cat "${readerout}")" = $'a\nb\nc' ]
}

@test "a mirror tap loses no line of a burst that its writer closes before the tap has read it" {
    cat "${realfifo}" > "${readerout}" &
    local reader_pid=$!
    start_tap

    seq 1 2000 > "${shimfifo}"

    debasher::_stop_fifo_mirror_taps
    wait "${reader_pid}"
    [ "$(wc -l < "${readerout}")" -eq 2000 ]
    cmp -s "${readerout}" "${mirrorfile}"
}

@test "a mirror tap forwards a last line without a newline as it was written" {
    cat "${realfifo}" > "${readerout}" &
    local reader_pid=$!
    start_tap

    printf 'a\nb' > "${shimfifo}"

    debasher::_stop_fifo_mirror_taps 2> "${BATS_TEST_TMPDIR}/stderr"
    wait "${reader_pid}"
    [ ! -s "${BATS_TEST_TMPDIR}/stderr" ]
    [ "$(od -An -c "${readerout}" | tr -d ' ')" = "a\nb" ]
    [ "$(od -An -c "${mirrorfile}" | tr -d ' ')" = "a\nb" ]
}

@test "a mirror tap retries a line that finds no reader between two opens of a reader that opens the fifo anew for each line" {
    start_tap

    printf 'one\n' > "${shimfifo}"
    IFS= read -r _ < "${realfifo}"
    # No reader now: the write of two fails with SIGPIPE, which must not end
    # the tap
    printf 'two\n' > "${shimfifo}"
    "${SLEEP}" 0.3
    kill -0 "${tap_pid}"

    local got
    got=$(IFS= read -r line < "${realfifo}" && printf '%s' "${line}")
    [ "${got}" = "two" ]
    debasher::_stop_fifo_mirror_taps
}

@test "a mirror tap ends with the end of the data when its owner is killed, and its reader gets every line the owner wrote" {
    cat "${realfifo}" > "${readerout}" &
    local reader_pid=$!
    # The owner is a shell of its own, killed with SIGKILL after writing,
    # without closing anything: the system closes its write end of the shim
    bash -c '
        debasher_pkglibdir="$1"; SLEEP="$(command -v sleep)"; CAT="$(command -v cat)"
        source "$1/debasher_lib.sh"
        debasher::_run_fifo_mirror_tap "$2" "$3" "$4" "$$" &
        exec 6>"$2"
        seq 1 1000 >&6
        kill -9 $$' _ "${ENGINE_BUILDDIR}" "${shimfifo}" "${realfifo}" "${mirrorfile}" &
    owner_pid=$!

    wait "${reader_pid}"
    [ "$(wc -l < "${readerout}")" -eq 1000 ]
    cmp -s "${readerout}" "${mirrorfile}"
}

@test "a mirror tap whose owner is gone ends instead of retrying a line that no reader will take" {
    bash -c '
        debasher_pkglibdir="$1"; SLEEP="$(command -v sleep)"; CAT="$(command -v cat)"
        source "$1/debasher_lib.sh"
        debasher::_run_fifo_mirror_tap "$2" "$3" "$4" "$$" &
        echo $! > "$5"
        exec 6>"$2"
        printf "one\ntwo\n" >&6
        sleep 30' _ "${ENGINE_BUILDDIR}" "${shimfifo}" "${realfifo}" "${mirrorfile}" "${BATS_TEST_TMPDIR}/tap_pid" &
    owner_pid=$!
    # The reader takes one line and leaves
    IFS= read -r _ < "${realfifo}"
    wait_for_mirror_lines 2
    tap_pid=$(cat "${BATS_TEST_TMPDIR}/tap_pid")
    kill -0 "${tap_pid}"

    kill -9 "${owner_pid}"
    wait_until_gone "${tap_pid}" 2
}

@test "debasher::_stop_fifo_mirror_taps ends a tap at once when its reader has read everything, with no warning" {
    cat "${realfifo}" > "${readerout}" &
    local reader_pid=$!
    start_tap
    printf 'one\n' > "${shimfifo}"
    wait_for_mirror_lines 1

    local start=$(now_ms)
    debasher::_stop_fifo_mirror_taps 2> "${BATS_TEST_TMPDIR}/stderr"
    local status=$?
    local elapsed=$(( $(now_ms) - start ))

    [ "${status}" -eq 0 ]
    [ "${elapsed}" -lt 1000 ]
    [ ! -s "${BATS_TEST_TMPDIR}/stderr" ]
    ! kill -0 "${tap_pid}" 2>/dev/null || false
    wait "${reader_pid}"
}

@test "debasher::_stop_fifo_mirror_taps waits for a slow reader, which gets every line" {
    ( "${SLEEP}" 3; cat "${realfifo}" > "${readerout}" ) &
    local reader_pid=$!
    start_tap
    seq 1 2000 > "${shimfifo}"

    debasher::_stop_fifo_mirror_taps 2> "${BATS_TEST_TMPDIR}/stderr"
    [ "$?" -eq 0 ]
    [ ! -s "${BATS_TEST_TMPDIR}/stderr" ]
    wait "${reader_pid}"
    [ "$(wc -l < "${readerout}")" -eq 2000 ]
}

@test "debasher::_stop_fifo_mirror_taps lets a tap whose reader is gone give the rest up, with a warning, and every line is in its mirror log" {
    DEBASHER_FIFO_MIRROR_TAP_STOP_GRACE_SECS=1
    start_tap
    printf 'one\n' > "${shimfifo}"
    IFS= read -r _ < "${realfifo}"
    printf 'two\nthree\n' > "${shimfifo}"
    wait_for_mirror_lines 2

    local start=$(now_ms)
    debasher::_stop_fifo_mirror_taps 2> "${BATS_TEST_TMPDIR}/stderr"
    [ "$?" -eq 0 ]
    [ $(( $(now_ms) - start )) -lt 3000 ]
    ! kill -0 "${tap_pid}" 2>/dev/null || false
    grep -q "Warning: the reader of the fifo mirrored by ${shimfifo} is gone" "${BATS_TEST_TMPDIR}/stderr"
    [ "$(cat "${mirrorfile}")" = $'one\ntwo\nthree' ]
}

@test "debasher::_stop_fifo_mirror_taps reports a tap that ended with an error" {
    start_tap
    kill -9 "${tap_pid}"
    "${SLEEP}" 0.1

    run debasher::_stop_fifo_mirror_taps
    [ "${status}" -eq 1 ]
    [[ "${output}" == *"Error: fifo mirror tap for ${shimfifo} exited abnormally"* ]]
}

# --- starting the taps of a task -------------------------------------------

@test "debasher::_start_fifo_mirror_taps_for_process gives the shim to the output option of each mirrored fifo only, and the real fifos get every line" {
    DEBASHER_PROGRAM_OUTDIR="${BATS_TEST_TMPDIR}/outd"
    MKFIFO="$(command -v mkfifo)"; MKDIR="$(command -v mkdir)"; RM="$(command -v rm)"
    DIRNAME="$(command -v dirname)"
    local sep="${DEBASHER_ASSOC_ARRAY_ELEM_SEP}"
    declare -gA DEBASHER_PROGRAM_FIFOS=(["w/f"]="w${sep}0" ["w/g"]="w${sep}0" ["w/h"]="w${sep}0")
    declare -gA DEBASHER_FIFO_MIRRORED=(["w/f"]=1 ["w/g"]=1)
    debasher::_prepare_fifos_owned_by_process w
    local fd=$(debasher::_get_absolute_fifodir)
    DEBASHER_DESERIALIZED_ARGS=(-outf "${fd}/w/f" -outg "${fd}/w/g" -outh "${fd}/w/h" -inf "${fd}/w/f")
    cat "${fd}/w/f" > "${readerout}.f" &
    local reader_f=$!
    cat "${fd}/w/g" > "${readerout}.g" &
    local reader_g=$!

    debasher::_start_fifo_mirror_taps_for_process

    [ "${DEBASHER_DESERIALIZED_ARGS[1]}" = "$(debasher::_get_fifo_shim_name w/f)" ]
    [ "${DEBASHER_DESERIALIZED_ARGS[3]}" = "$(debasher::_get_fifo_shim_name w/g)" ]
    [ "${DEBASHER_DESERIALIZED_ARGS[5]}" = "${fd}/w/h" ]
    [ "${DEBASHER_DESERIALIZED_ARGS[7]}" = "${fd}/w/f" ]
    [ "${#DEBASHER_FIFO_MIRROR_TAP_PIDS[@]}" -eq 2 ]
    [ "${#DEBASHER_FIFO_MIRROR_TAP_FDS[@]}" -eq 2 ]

    printf 'to f\n' > "${DEBASHER_DESERIALIZED_ARGS[1]}"
    printf 'to g\n' > "${DEBASHER_DESERIALIZED_ARGS[3]}"
    debasher::_stop_fifo_mirror_taps
    wait "${reader_f}" "${reader_g}"
    [ "$(cat "${readerout}.f")" = "to f" ]
    [ "$(cat "${readerout}.g")" = "to g" ]
    [ "$(cat "$(debasher::_get_fifo_mirror_filename w/g)")" = "to g" ]
}

# --- resident programs refuse --mirror -------------------------------------
#
# The check happens as soon as the flag is seen, before define_fifo_opt
# needs any of the process-definition state a real module call provides,
# so these tests can exercise it directly.

@test "debasher::_check_fifo_mirror_allowed accepts --mirror in a general program" {
    DEBASHER_PROGRAM_TYPE="${DEBASHER_PROGRAM_TYPE_GENERAL}"

    run debasher::_check_fifo_mirror_allowed "define_fifo_opt"

    [ "${status}" -eq 0 ]
    [ -z "${output}" ]
}

@test "debasher::_check_fifo_mirror_allowed rejects --mirror in a resident program and names the caller" {
    DEBASHER_PROGRAM_TYPE="${DEBASHER_PROGRAM_TYPE_RESIDENT}"

    run debasher::_check_fifo_mirror_allowed "define_fifo_opt"

    [ "${status}" -eq 1 ]
    [[ "${output}" == *"define_fifo_opt: Error, --mirror cannot be used in a 'resident' program"* ]]
}

@test "debasher::define_fifo_opt aborts on --mirror in a resident program" {
    DEBASHER_PROGRAM_TYPE="${DEBASHER_PROGRAM_TYPE_RESIDENT}"

    run debasher::define_fifo_opt "-outf" "somefifo" optlist --mirror

    [ "${status}" -eq 1 ]
    [[ "${output}" == *"define_fifo_opt: Error, --mirror cannot be used in a 'resident' program"* ]]
}

@test "debasher::define_fifo_opt_generator aborts on --mirror in a resident program" {
    DEBASHER_PROGRAM_TYPE="${DEBASHER_PROGRAM_TYPE_RESIDENT}"

    run debasher::define_fifo_opt_generator "-outf" "somefifo" 0 optlist --mirror

    [ "${status}" -eq 1 ]
    [[ "${output}" == *"define_fifo_opt: Error, --mirror cannot be used in a 'resident' program"* ]]
}
